# ─── Lectora: локальная конфигурация ─────────────────────────────────────────
# Скопируйте в .env и при необходимости измените. Ключи API не нужны.

# --- сервер ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO

# --- база данных ----------------------------------------------------------
DATABASE_URL=postgresql+psycopg://lectora:lectora@127.0.0.1:5433/lectora

# --- хранилище и лимиты ---------------------------------------------------
STORAGE_DIR=storage
MAX_UPLOAD_MB=4096

# --- модели ---------------------------------------------------------------
MODELS_DIR=models
ASR_MODEL_ACCURATE=models/vosk/vosk-model-ru-0.42
ASR_MODEL_FAST=models/vosk/vosk-model-small-ru-0.22
ASR_DEFAULT_PROFILE=accurate
ASR_THREADS=8
EMBEDDING_MODEL_PATH=models/embeddings/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
RERANKER_MODEL_PATH=models/reranker/bge-reranker-v2-m3
RERANKER_ENABLED=1

# --- локальная LLM (llama-server) ----------------------------------------
LLM_ENABLED=1
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=qwen2.5-7b-instruct
LLM_TIMEOUT=180
LLM_MAX_TOKENS=1400
PUNCTUATION_MODE=rules

# --- инструменты ----------------------------------------------------------
FFMPEG_BIN=
FFPROBE_BIN=
YTDLP_BIN=
ALLOW_URL_IMPORT=1

# --- обработка ------------------------------------------------------------
WORKER_THREADS=1
WARMUP=1
