# ─── Lectora: локальная конфигурация ─────────────────────────────────────────
# Скопируйте в .env и при необходимости измените.
# Транскрибация всегда локальная (Vosk/Whisper). Конспект можно собирать тремя
# способами: DeepSeek API, локальная LLM или офлайн-алгоритм.

# --- сервер ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO

# --- база данных ----------------------------------------------------------
DATABASE_URL=postgresql+psycopg://lectora:lectora@127.0.0.1:5433/lectora

# --- хранилище и лимиты ---------------------------------------------------
STORAGE_DIR=storage
MAX_UPLOAD_MB=4096
MIN_FREE_DISK_GB=8

# --- модели ---------------------------------------------------------------
MODELS_DIR=models
ASR_MODEL_ACCURATE=models/vosk/vosk-model-ru-0.42
ASR_MODEL_FAST=models/vosk/vosk-model-small-ru-0.22
ASR_DEFAULT_PROFILE=accurate
ASR_THREADS=8
EMBEDDING_MODEL_PATH=models/embeddings/bge-m3
# Устройство для поисковых запросов до первой загрузки модели; лекции с включённой
# видеокартой индексируются на CUDA независимо от этого значения.
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=16
RERANKER_MODEL_PATH=models/reranker/bge-reranker-v2-m3
RERANKER_ENABLED=1

# --- локальная LLM (llama-server) ----------------------------------------
LLM_ENABLED=1
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=qwen2.5-7b-instruct
LLM_TIMEOUT=180
LLM_MAX_TOKENS=1400
PUNCTUATION_MODE=rules

# --- режим конспекта по умолчанию ----------------------------------------
# api     — DeepSeek Web через tools/FreeDeepseekAPI (подробный конспект)
# local   — локальная llama.cpp
LLM_MODE=api

# --- DeepSeek Web API (FreeDeepseekAPI) -----------------------------------
# Запуск прокси: tools/FreeDeepseekAPI → npm start (127.0.0.1:9655).
# API_LLM_KEY нужен только если в прокси задан PROXY_API_KEY.
API_LLM_ENABLED=1
API_LLM_BASE_URL=http://127.0.0.1:9655/v1
API_LLM_MODEL=deepseek-v4-flash
API_LLM_KEY=
API_LLM_TIMEOUT=600
API_LLM_MAX_TOKENS=8192
API_LLM_TEMPERATURE=0.3
# Промпт держим ниже DEEPSEEK_MAX_PROMPT_CHARS прокси (по умолчанию 80000).
API_LLM_MAX_PROMPT_CHARS=42000
API_LLM_MAX_INPUT_CHARS=34000
API_LLM_MAP_WINDOW_CHARS=12000
API_LLM_MAX_MAP_WINDOWS=16
API_LLM_DETAILS_BATCH_CHARS=9000
# Аккаунт DeepSeek Web один: запросы идут по очереди с паузой и ретраями.
API_LLM_MIN_INTERVAL_SEC=3
API_LLM_MAX_CONCURRENT=1
API_LLM_RETRY_ATTEMPTS=3
API_LLM_RETRY_BASE_SEC=4
API_LLM_RETRY_MAX_SEC=90
API_LLM_QUEUE_TIMEOUT_SEC=900
API_LLM_SESSION_PREFIX=lectora
API_LLM_RESET_SESSION=1
API_LLM_NOTES_MIN_SECTIONS=6
API_LLM_NOTES_MAX_SECTIONS=14
API_LLM_SUMMARY_MIN_WORDS=140

# --- инструменты ----------------------------------------------------------
FFMPEG_BIN=
FFPROBE_BIN=
YTDLP_BIN=
ALLOW_URL_IMPORT=1

# --- обработка ------------------------------------------------------------
WORKER_THREADS=1
WARMUP=1
ASR_KEEP_WARM=0
WHISPER_MODEL=small
WHISPER_MODEL_DIR=models/whisper
WHISPER_COMPUTE_TYPE=int8_float16
